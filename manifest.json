{
  "manifest_version": 3,
  "name": "FB Post & Comments to Markdown + Reposts Opener",
  "version": "2.4.0",
  "description": "Экспорт постов Facebook со всеми ветками комментариев в чистый Markdown (.MD) и открытие скрытой ленты репостов в один клик.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}